#!/bin/sh
# dindin-snapshot v2 — snapshot diario do banco SQLite (roda como o usuario do
# app, ex.: dindinapp, via cron). SEM poda por idade de .db: quem remove o .db
# sem cifra e o dindin-backup-upload, somente o do dia e somente apos dupla
# confirmacao de envio (duas nuvens). Backup pendente nunca e apagado por
# ficar antigo.
set -e
D=${DINDIN_BACKUP_DIR:-/srv/dindin/backups}
DB=${DINDIN_DATA_DB:-/srv/dindin/data/dindin.db}
HOJE=${DINDIN_HOJE:-$(date +%F)}
sqlite3 "$DB" ".backup '$D/dindin-$HOJE.db'"
chmod 600 "$D/dindin-$HOJE.db" 2>/dev/null || true
